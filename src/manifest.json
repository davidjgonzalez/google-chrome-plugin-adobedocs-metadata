{
  "name": "AdobeDocs metadata",
  "version": "1.41.1",
  "description": "AdobeDocs metadata extension!",
  "permissions": ["activeTab", "declarativeContent", "storage", "scripting"],

  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*"
  ],

  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  
  "options_page": "options.html",

  "action": {
    "default_popup": "popup.html"
  },

  "web_accessible_resources": [{
    "resources": ["/extra/*"],
    "matches": ["<all_urls>"]
  }],

  "content_scripts": [{
    "matches": [
      "https://experienceleague.adobe.com/*"
      ],
    "js": ["content-exl.js"],
    "css": ["content-exl.css"]
  },
  {
    "matches": [
      "*://jira.corp.adobe.com/*"
      ],
    "js": ["content-jira.js"],
    "css": ["content-jira.css"]
  },
  {
    "matches": [
      "https://github.com/Adobe-Enterprise-Docs/*"
      ],
    "js": ["content-github.js"],
    "run_at": "document_idle"
  },
  {
    "matches": [
      "https://github.com/Adobe-Enterprise-Docs/*"
      ],
    "js": ["content-github-main.js"],
    "run_at": "document_idle",
    "world": "MAIN"
  }],
  "icons": { 
    "16": "icon128.png",
    "48": "icon128.png",
   "128": "icon128.png" 
  },
 
  "manifest_version": 3,

  "commands": {
    "chrome_action": {
      "description": "Open AdobeDocs Metadata",
      "suggested_key": {
        "mac": "Ctrl+K",
        "windows": "Ctrl+Shift+K",
        "chromeos": "Ctrl+Shift+K",
        "linux": "Ctrl+Shift+K"
      }
    }
  }
}
